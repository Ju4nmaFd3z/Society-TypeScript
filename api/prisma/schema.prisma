// Modelo de datos de SOCIETY. Fuente: docs/mvp/diccionario_datos.md §3.
// Nombres en castellano y snake_case (D-21), igual en Prisma que en Postgres.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Datos de la cuenta que no están en Supabase Auth.
// id es el mismo uuid que auth.users.id.
model perfil_usuario {
  id                    String       @id @db.Uuid
  email                 String
  nombre                String?
  terminos_version      String
  terminos_aceptados_en DateTime     @db.Timestamptz(6)
  creado_en             DateTime     @default(now()) @db.Timestamptz(6)
  restaurante           restaurante?
}

// El local. En el MVP, un restaurante por usuario (owner_id único, D-13).
model restaurante {
  id                     String         @id @default(uuid()) @db.Uuid
  owner_id               String         @unique @db.Uuid
  owner                  perfil_usuario @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  origen                 String // GOOGLE · MANUAL
  google_place_id        String?        @unique
  nombre                 String
  apodo                  String?
  tipo                   String? // RESTAURANTE · BAR · CAFETERIA · OTRO
  direccion              String
  municipio              String
  provincia              String?
  latitud                Float?
  longitud               Float?
  telefono               String?
  tipo_google            String?
  horario                Json?
  google_maps_uri        String?
  datos_google_leidos_en DateTime?      @db.Timestamptz(6)
  alta_estado            String         @default("CREADO") // CREADO · ANALIZANDO · PENDIENTE_CONFIRMAR · COMPLETADA
  declara_gestor_en      DateTime       @db.Timestamptz(6)
  creado_en              DateTime       @default(now()) @db.Timestamptz(6)
  actualizado_en         DateTime       @updatedAt @db.Timestamptz(6)
  canales                canal[]
}

// Dónde está el local en internet: su web, su Instagram, su teléfono...
model canal {
  id              String      @id @default(uuid()) @db.Uuid
  restaurante_id  String      @db.Uuid
  restaurante     restaurante @relation(fields: [restaurante_id], references: [id], onDelete: Cascade)
  tipo            String // WEB · INSTAGRAM · TIKTOK · WHATSAPP · TELEFONO
  valor           String // URL, @usuario o teléfono
  fuente          String // GOOGLE · WEB · USUARIO · INSTAGRAM
  acepta_reservas Boolean     @default(false)
  editado         Boolean     @default(false) // si el usuario lo cambió, el análisis no lo pisa

  @@unique([restaurante_id, tipo, valor])
}

// Cola de trabajos largos (D-28, D-36). La API inserta una fila y el worker
// (rutas /trabajos) la ejecuta por fases. Lo reclama reclamar_trabajo(), en la migración.
model trabajo {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // también al insertar a mano en SQL
  tipo                String // ANALISIS · PLAN_PIEZA · IMAGEN_DIAPOSITIVA · PUBLICAR_INSTAGRAM · RENOVAR_TOKENS_IG · PRUEBA
  estado              String    @default("PENDIENTE") // PENDIENTE · EN_CURSO · HECHO · ERROR · CANCELADO
  fase                Int       @default(0) // la siguiente fase que hay que ejecutar
  datos               Json      @default("{}")
  intentos            Int       @default(0) // fallos seguidos de la fase actual
  ejecutar_despues_de DateTime  @default(now()) @db.Timestamptz(6)
  bloqueado_en        DateTime? @db.Timestamptz(6) // cuándo lo reclamó el worker
  idempotency_key     String?   @unique // evita encolar dos veces lo mismo
  error               String?
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([estado, ejecutar_despues_de])
}
