# Copia este archivo como .env y rellena los valores.
# Los valores reales están en el gestor de secretos del equipo. Nunca se suben a git.

# Base de datos (Supabase → Connect → ORMs → Prisma)
# Transaction pooler, puerto 6543: lo usa la API en Vercel
DATABASE_URL=
# Session pooler, puerto 5432: lo usa Prisma para las migraciones
DIRECT_URL=

# Supabase (Project Settings → Data API / API Keys)
SUPABASE_URL=
# Clave secreta (service_role). Solo en la API, nunca en los clientes
SUPABASE_SECRET_KEY=

# Puerto local de la API
PORT=3000

# Clave de la API Google places(new)
GOOGLE_PLACES_API_KEY=
