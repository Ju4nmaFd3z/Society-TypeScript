{
  "name": "society-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de SOCIETY: Express + TypeScript (rutas → controladores → servicios), desplegada en Vercel",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/local.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
